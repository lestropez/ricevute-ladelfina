{
  "name": "Lestropez Spese",
  "short_name": "Spese",
  "description": "Invio ricevute e scontrini a OneDrive per la riconciliazione – Lestropez / La Delfina",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#B79935",
  "theme_color": "#B79935",
  "icons": [
    {
      "src": "icon-192.png?v=6",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png?v=6",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-192.png?v=6",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icon-512.png?v=6",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "./share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "files",
          "accept": [
            "image/*",
            "application/pdf",
            ".jpg",
            ".jpeg",
            ".png",
            ".heic",
            ".pdf"
          ]
        }
      ]
    }
  }
}